# Authentication mode: oauth is simplest for your own Google access.
# service_account is better for client-by-client delegated access.
GOOGLE_AUTH_MODE=oauth

# Paths below must be ABSOLUTE. `~` is not expanded — write the full path to
# your own ~/.config/gsc-ga4-mcp/ directory.

# OAuth installed/Desktop app JSON downloaded from Google Cloud Console.
# Do not commit this file.
GOOGLE_OAUTH_CREDENTIALS_FILE=/Users/YOUR_USER/.config/gsc-ga4-mcp/oauth-client.json

# Local token generated by `npm run auth`. Do not commit this file.
GOOGLE_TOKEN_PATH=/Users/YOUR_USER/.config/gsc-ga4-mcp/token.json

# Optional. Must match the redirect URI used by auth-cli.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/oauth2callback

# Service account mode only. Add the service account email to GSC/GA4 with read permissions.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/Users/YOUR_USER/.config/gsc-ga4-mcp/service-account.json

# Optional defaults so Claude Code can omit IDs in quick prompts.
MCP_DEFAULT_GSC_SITE=sc-domain:example.com
MCP_DEFAULT_GA4_PROPERTY=properties/123456789

# Optional project mapping file. Copy projects.example.json to projects.json and edit.
PROJECTS_CONFIG=/Users/YOUR_USER/.config/gsc-ga4-mcp/projects.json

# Optional guardrails.
MAX_ROWS=25000
